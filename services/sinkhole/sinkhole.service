[Unit]
Description=Sandbox network sinkhole (fake DNS and HTTP)
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/sinkhole/sinkhole.py
Restart=always
RestartSec=1
# Unprivileged user, allowed only to bind ports 53 and 80. The log stays
# readable for the worker, which correlates it with jobs.
User=sinkhole
Group=sinkhole
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LogsDirectory=sinkhole
LogsDirectoryMode=0755
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
