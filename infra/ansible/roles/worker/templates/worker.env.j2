{% set creds = worker_k8s_secret.stdout | from_json %}
# Managed by Ansible from the cluster Secret detonator-credentials.
DATABASE_URL=postgresql://detonator:{{ creds.data['postgres-password'] | b64decode }}@{{ worker_control_plane_ip }}:{{ worker_postgres_port }}/detonator
AMQP_URL=amqp://detonator:{{ creds.data['rabbitmq-password'] | b64decode }}@{{ worker_control_plane_ip }}:{{ worker_rabbitmq_port }}/%2F
S3_ENDPOINT=http://{{ worker_control_plane_ip }}:{{ worker_objectstore_port }}
S3_ACCESS_KEY={{ creds.data['s3-access-key'] | b64decode }}
S3_SECRET_KEY={{ creds.data['s3-secret-key'] | b64decode }}
SAMPLE_TIMEOUT={{ worker_sample_timeout }}
METRICS_ADDR={{ worker_control_plane_ip }}
