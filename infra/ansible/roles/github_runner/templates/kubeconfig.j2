{% set sa = github_runner_sa.stdout | from_json %}
apiVersion: v1
kind: Config
clusters:
  - name: detonator
    cluster:
      server: {{ github_runner_api_server }}
      certificate-authority-data: {{ sa.data['ca.crt'] }}
users:
  - name: github-runner
    user:
      token: {{ sa.data.token | b64decode }}
contexts:
  - name: detonator
    context:
      cluster: detonator
      user: github-runner
      namespace: {{ github_runner_namespace }}
current-context: detonator
